{
	"name": "@triplett/stew",
	"version": "4.0.0",
	"description": "A stateful virtual DOM for any purpose.",
	"author": "triplett",
	"license": "MIT",
	"main": "dist/stew.min.js",
	"module": "dist/stew.min.mjs",
	"bin": "dist/server.js",
	"scripts": {
		"test": "jest --watch",
		"build": "rimraf dist && node build.mjs",
		"start": "node dist/server.js"
	},
	"keywords": [
		"state",
		"view",
		"declarative",
		"extensible"
	],
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/codetriplett/stew.git"
	},
	"bugs": {
		"url": "https://github.com/codetriplett/stew/issues"
	},
	"homepage": "https://github.com/codetriplett/stew#readme",
	"jest": {
		"testEnvironmentOptions": {
			"url": "http://localhost"
		},
		"setupFilesAfterEnv": [
			"./setupTests.js"
		]
	},
	"devDependencies": {
		"@babel/preset-env": "7.21.4",
		"esbuild": "^0.25.5",
		"esbuild-plugin-copy": "^2.1.1",
		"jest": "29.5.0",
		"regenerator-runtime": "0.13.11",
		"rimraf": "4.4.1"
	}
}
